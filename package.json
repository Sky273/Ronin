{
  "name": "ronin-io",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:sim": "esbuild tests/sim.smoke.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/sim.smoke.mjs && node node_modules/.cache/sim.smoke.mjs",
    "test:scores": "esbuild tests/highscores.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/highscores.test.mjs && node node_modules/.cache/highscores.test.mjs",
    "test": "npm run test:sim && npm run test:scores"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}

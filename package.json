{
  "name": "ronin-io",
  "version": "0.1.0",
  "private": true,
  "description": "Ronin.io — a side-scrolling samurai .io game painted in Japanese ink (sumi-e).",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sky273/Ronin.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:sim": "esbuild tests/sim.smoke.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/sim.smoke.mjs && node node_modules/.cache/sim.smoke.mjs",
    "test:scores": "esbuild tests/highscores.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/highscores.test.mjs && node node_modules/.cache/highscores.test.mjs",
    "test:gameover": "esbuild tests/gameover.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/gameover.test.mjs && node node_modules/.cache/gameover.test.mjs",
    "test": "npm run test:sim && npm run test:scores && npm run test:gameover && npm run test:melody && npm run test:levelgen && npm run test:stages && npm run test:snapshot && npm run test:coop && npm run test:remote && npm run test:server",
    "test:melody": "esbuild tests/melody.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/melody.test.mjs && node node_modules/.cache/melody.test.mjs",
    "test:levelgen": "esbuild tests/levelgen.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/levelgen.test.mjs && node node_modules/.cache/levelgen.test.mjs",
    "test:stages": "esbuild tests/stages.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/stages.test.mjs && node node_modules/.cache/stages.test.mjs",
    "dev:server": "tsx watch server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "start:server": "node dist-server/index.mjs",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "bots": "tsx server/bots.ts",
    "test:coop": "esbuild tests/coop.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/coop.test.mjs && node node_modules/.cache/coop.test.mjs",
    "test:snapshot": "esbuild tests/snapshot.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/snapshot.test.mjs && node node_modules/.cache/snapshot.test.mjs",
    "test:remote": "esbuild tests/remote.test.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/remote.test.mjs && node node_modules/.cache/remote.test.mjs",
    "test:server": "tsx tests/server.test.ts"
  },
  "dependencies": {
    "@colyseus/better-call": "1.3.3",
    "@colyseus/core": "0.18.18",
    "@colyseus/schema": "5.0.40",
    "@colyseus/sdk": "0.18.5",
    "@colyseus/ws-transport": "0.18.4",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.25.12",
    "tsx": "4.23.15",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
